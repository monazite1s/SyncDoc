<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0" type="device">
  <diagram id="uc2" name="图3-3 协同编辑用例图">
    <mxGraphModel dx="1100" dy="750" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- 系统边界 -->
        <mxCell id="b1" value="协同编辑子系统" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=none;align=center;fontSize=15;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="180" y="20" width="620" height="620" as="geometry"/>
        </mxCell>

        <!-- 角色 -->
        <mxCell id="a1" value="编辑者" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="55" y="240" width="35" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="查看者" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="880" y="340" width="35" height="60" as="geometry"/>
        </mxCell>

        <!-- 用例 -->
        <mxCell id="u1" value="进入编辑器" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="60" width="120" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="u2" value="实时同步编辑" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="170" width="130" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="u3" value="光标感知" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="310" width="110" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="u4" value="查看文档内容" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="380" width="130" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="u5" value="冲突自动合并" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="530" y="170" width="130" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="u6" value="离线编辑" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="440" width="110" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="u7" value="网络恢复同步" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="550" width="130" height="40" as="geometry"/>
        </mxCell>

        <!-- ====== 关联线: 编辑者 ====== -->
        <mxCell id="ea1" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" source="a1" target="u1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea2" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" source="a1" target="u2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea3" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" source="a1" target="u3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea4" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" source="a1" target="u4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea6" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" source="a1" target="u6" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ====== 关联线: 查看者 ====== -->
        <mxCell id="eb4" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" source="a2" target="u4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb1" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" source="a2" target="u1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ====== &#171;include&#187;: 实时同步编辑 → 冲突自动合并 ====== -->
        <mxCell id="i1" value="&#171;include&#187;" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;fontStyle=2;strokeColor=#0066CC;" edge="1" source="u2" target="u5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ====== &#171;extend&#187;: 离线编辑 → 实时同步编辑 ====== -->
        <mxCell id="x1" value="&#171;extend&#187;" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;fontStyle=2;strokeColor=#CC6600;" edge="1" source="u6" target="u2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ====== &#171;extend&#187;: 网络恢复同步 → 离线编辑 ====== -->
        <mxCell id="x2" value="&#171;extend&#187;" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;fontStyle=2;strokeColor=#CC6600;" edge="1" source="u7" target="u6" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
