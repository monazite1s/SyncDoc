<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0" type="device">
  <diagram id="uc3" name="图3-4 版本管理用例图">
    <mxGraphModel dx="1100" dy="750" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- 系统边界 -->
        <mxCell id="b1" value="版本管理子系统" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=none;align=center;fontSize=15;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="580" height="660" as="geometry"/>
        </mxCell>

        <!-- 角色 -->
        <mxCell id="a1" value="文档拥有者" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="35" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="编辑者" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="940" y="240" width="35" height="60" as="geometry"/>
        </mxCell>

        <!-- 用例 -->
        <mxCell id="u1" value="查看版本列表" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="60" width="130" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="u2" value="查看版本详情" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="160" width="130" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="u3" value="创建手动版本" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="270" width="140" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="u4" value="版本对比" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="380" width="120" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="u5" value="版本回溯" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="490" width="120" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="u6" value="设置版本标签" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="110" width="130" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="u7" value="创建恢复快照" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="560" y="490" width="130" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="u8" value="自动保存版本" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="560" y="300" width="130" height="45" as="geometry"/>
        </mxCell>

        <!-- ====== 关联线: 文档拥有者 ====== -->
        <mxCell id="ea1" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" source="a1" target="u1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea2" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" source="a1" target="u2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea3" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" source="a1" target="u3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea4" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" source="a1" target="u4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea5" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" source="a1" target="u5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ====== 关联线: 编辑者 ====== -->
        <mxCell id="eb1" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" source="a2" target="u1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb2" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" source="a2" target="u2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb3" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" source="a2" target="u3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb4" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" source="a2" target="u4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ====== &#171;include&#187;: 版本回溯 → 创建恢复快照 ====== -->
        <mxCell id="i1" value="&#171;include&#187;" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;fontStyle=2;strokeColor=#0066CC;" edge="1" source="u5" target="u7" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ====== &#171;extend&#187;: 设置版本标签 → 查看版本详情 ====== -->
        <mxCell id="x1" value="&#171;extend&#187;" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;fontStyle=2;strokeColor=#CC6600;" edge="1" source="u6" target="u2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ====== &#171;extend&#187;: 自动保存版本 → 创建手动版本 ====== -->
        <mxCell id="x2" value="&#171;extend&#187;" style="dashed=1;endArrow=open;endSize=8;html=1;fontSize=11;fontStyle=2;strokeColor=#CC6600;" edge="1" source="u8" target="u3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
